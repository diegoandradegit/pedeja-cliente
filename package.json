{
  "name": "pedeja",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev:cliente": "pnpm --filter @pedeja/cliente dev",
    "dev:entregador": "pnpm --filter @pedeja/entregador dev",
    "dev:restaurante": "pnpm --filter @pedeja/restaurante dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
